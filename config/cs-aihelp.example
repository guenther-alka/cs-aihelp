# cs-aihelp configuration -- see data/howto.ai/ai-helpdesk.info
# Written by csweb-gui AI Helpdesk menu (System > Services > AI Helpdesk).
# DO NOT SHARE: api_key holds your cloud provider key when mode=provider.

mode         = free
provider     = openai
endpoint     = 
model        = 
api_key      = 
mode2        = 
provider2    = openai
endpoint2    = 
model2       = 
api_key2     = 
free_model2  = 
free_model   = 
exec_access  = ro
exec_mode    = confirm
exec_allow   = 
exec_deny    = zfs destroy|zpool destroy|rm -rf|dd |mkfs|format
autostart    = on
tool_use     = no
max_context  = 8000
history      = month
history_turns = 10
widget       = on
widget_input_lines  = 1
widget_answer_height = 220
research     = ddg
research_max = 5
research_endpoint = 
research_key = 
fallback     = free
log          = on
ssrf_allow_private = no
rate_limit   = 60

# Go daemon network (loopback; forwarded by the Perl CGI proxy)
listen       = 127.0.0.1:45555
auth_token   =
allowed_ip   =
cors_origin  =
tls_cert     = /opt/csweb-gui/_cfg/webserver/cert/server.crt
tls_key      = /opt/csweb-gui/_cfg/webserver/cert/server.key